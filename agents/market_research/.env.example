# LLM used by every agent (LiteLLM-style "provider/model" string)
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Optional: live web search via Serper (https://serper.dev). Without it the
# researcher works from the LLM's own knowledge and flags that limitation.
SERPER_API_KEY=

# Optional: enable crew memory (needs an embedder; defaults to OpenAI embeddings)
CREW_MEMORY=false
OPENAI_API_KEY=

# sequential (default) or hierarchical
CREW_PROCESS=sequential
